# Security headers for Cloudflare Pages.
# The Content-Security-Policy matches the one in index.html, plus frame-ancestors, which only works as a real header.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data: blob: https://api.dicebear.com; connect-src 'self' https://novum-push.ioanrhyshumph.workers.dev https://api.dicebear.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; manifest-src 'self'; font-src 'self'; media-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(), usb=()

# App code and styles: browsers must check for a newer copy every time (a quick "not modified" when
# nothing changed). Keeping them for hours mixed old and new files after an update.
/js/*
  Cache-Control: no-cache
/vendor/*
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
# Built files (npm run build) have a fingerprint in their name that changes whenever they do,
# so a copy can be kept for good
/dist/*
  Cache-Control: public, max-age=31536000, immutable
